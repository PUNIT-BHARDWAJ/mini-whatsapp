<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="wa-bar">
        <a href="/chats" class="wa-brand">&larr; All chats</a>
    </header>

    <main class="wa-main wa-narrow">
        <form method="post" action="/chats" class="wa-card">
            <h1 class="wa-title">Write a new chat</h1>

            <label class="wa-label" for="from">From</label>
            <input class="wa-input" id="from" type="text" name="from" placeholder="Who are you?" required>

            <label class="wa-label" for="to">To</label>
            <input class="wa-input" id="to" type="text" name="to" placeholder="Add receiver" required>

            <label class="wa-label" for="msg">Message <span class="wa-counter" data-for="msg">0 / 50</span></label>
            <textarea class="wa-input" id="msg" name="msg" rows="3" maxlength="50" placeholder="Write your message here..."></textarea>

            <button class="wa-btn wa-btn-full">Send chat</button>
        </form>
    </main>
    <script src="/app.js"></script>
</body>
</html>
