<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="wa-bar">
        <a href="/chats" class="wa-brand">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            Mini WhatsApp
        </a>
        <a href="/chats/new" class="wa-btn">+ New chat</a>
    </header>

    <main class="wa-main">
        <h1 class="wa-title">All chats <span class="wa-count"><%= chats.length %></span></h1>

        <div class="wa-list">
        <% for (let chat of chats) { %>
            <article class="wa-chat">
                <div class="wa-avatar" aria-hidden="true"><%= chat.from.charAt(0).toUpperCase() %></div>
                <div class="wa-chat-body">
                    <div class="wa-chat-head">
                        <span class="wa-people"><b><%= chat.from %></b> <span class="wa-arrow">&rarr;</span> <%= chat.to %></span>
                        <time datetime="<%= chat.created_at.toISOString() %>">
                            <%= chat.created_at.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" }) %>
                            &middot;
                            <%= chat.created_at.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                        </time>
                    </div>
                    <p class="wa-bubble"><%= chat.msg %></p>
                    <div class="wa-actions">
                        <a href="/chats/<%= chat._id %>" class="wa-chip">View</a>
                        <a href="/chats/<%= chat._id %>/edit" class="wa-chip">Edit</a>
                        <form method="post" action="/chats/<%= chat._id %>?_method=DELETE" class="wa-delete">
                            <button class="wa-chip wa-chip-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        <% } %>
        </div>

        <% if (chats.length === 0) { %>
            <p class="wa-empty">No chats yet. Start one with "New chat".</p>
        <% } %>
    </main>
    <script src="/app.js"></script>
</body>
</html>
