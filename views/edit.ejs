<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="wa-bar">
        <a href="/chats" class="wa-brand">&larr; All chats</a>
    </header>

    <main class="wa-main wa-narrow">
        <form method="post" action="/chats/<%= chat._id %>?_method=PUT" class="wa-card">
            <h1 class="wa-title">Edit chat</h1>
            <p class="wa-meta">From <b><%= chat.from %></b> to <b><%= chat.to %></b></p>

            <label class="wa-label" for="msg">Message <span class="wa-counter" data-for="msg"><%= (chat.msg || "").length %> / 50</span></label>
            <textarea class="wa-input" id="msg" name="msg" rows="3" maxlength="50"><%= chat.msg %></textarea>

            <button class="wa-btn wa-btn-full">Save changes</button>
        </form>
    </main>
    <script src="/app.js"></script>
</body>
</html>
